    "def query_obligation(scope_revision: ScopeRevision, obligation_id: ObligationID, reader: LedgerReader) -> ObligationView:",
    "def write_ledger(scope: AnalysisScope, rows: Iterator[LedgerRow], fresh_output: str, budgets: LedgerBudgets) -> LedgerReceipt:",
    "def read_ledger(receipt: LedgerReceipt, resolver: LedgerResolver, budgets: LedgerBudgets) -> LedgerReader:"
  ],
