    def _await_fork_body():
        """Two real first AWAIT frontiers, preserving their separate original ports."""
        from scar.ir.program.ids import BlockID, OperationID, UseID, ValueID
        from scar.ir.program.model import (AccessMode, Behavior, Block, BlockArgument, DataValue,
            LiteralOrigin, Operation, ReferenceValue, StateAccess, Successor, Terminator,
            Use, UseRole)
        from scar.ir.program.resumption import ResumableKind, SuspensionFlavor
        from tests.fixtures.program_driver_graphs import _body_with_environment
    
        graph = _body_with_environment()
        region = graph.regions[0]
        entry = next(block for block in region.blocks if block.id == region.entry)
        operations = {op.id: op for op in graph.operations}
        values = {value.id: value for value in graph.values}
        original = operations.pop(OperationID('resume.suspend'))
        source_values = tuple(dict.fromkeys(use.value for use in original.uses))
        predicate_id, branch_id = OperationID('pipeline.fork.read'), OperationID('pipeline.fork.branch')
        x = next(use.value for use in original.uses if use.id == original.terminator.exported)
        world_use = next(use for use in original.uses if use.role is UseRole.STATE_CONTENT
                         and values[use.value].location.value.endswith('.world'))
        owner = Use(UseID('pipeline.fork.owner'), x, UseRole.REFERENCE)
        state = Use(UseID('pipeline.fork.state'), world_use.value, UseRole.STATE_CONTENT)
