          "",
          "\t/*",
          "\t * If the delay timer has expired, then its expiration",
          "\t * has been handled already by the signal handler.",
          "\t *",
          "\t * If the delay timer expires during wait4(),",
          "\t * then the system call will be interrupted and",
          "\t * the expiration will be handled by the signal handler.",
          "\t */",
          "\tint status;",
          "\tstruct rusage ru;",
          "\tint pid = wait4(-1, &status, __WALL, (cflag ? &ru : NULL));",
          "\tint wait_errno = errno;",
          "",
          "\t/*",
          "\t * The window of opportunity to handle expirations",
