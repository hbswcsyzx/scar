          "dispatch_event(const struct tcb_wait_data *wd)",
          "{",
          "\tunsigned int restart_op;",
          "\tunsigned int restart_sig = 0;",
          "\tenum trace_event te = wd ? wd->te : TE_BREAK;",
          "\t/*",
          "\t * Copy wd->status to a non-const variable to workaround glibc bugs",
