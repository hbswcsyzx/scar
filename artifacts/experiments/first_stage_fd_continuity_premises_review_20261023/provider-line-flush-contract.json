    "static void",
    "flush_tcp_output(const struct tcb *const tcp)",
    "{",
    "\tif (fflush(tcp->outf))",
    "\t\toutf_perror(tcp);",
    "}",
    "",
    "void",
    "line_ended(void)",
    "{",
    "\tif (current_tcp) {",
    "\t\tcurrent_tcp->curcol = 0;",
    "\t\tflush_tcp_output(current_tcp);",
    "\t}",
    "\tif (printing_tcp) {",
    "\t\tprinting_tcp->curcol = 0;",
    "\t\tprinting_tcp = NULL;",
    "\t}",
    "}",
    "",
    "static void",
    "set_current_tcp(const struct tcb *tcp)",
    "{",
    "\tcurrent_tcp = (struct tcb *) tcp;",
    "",
    "\t/* Sync current_personality and stuff */",
    "\tif (current_tcp)",
    "\t\tset_personality(current_tcp->currpers);",
    "}",
